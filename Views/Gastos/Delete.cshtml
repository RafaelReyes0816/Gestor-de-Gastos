@model Gestor_Gastos.Models.Gasto
@{
    ViewData["Title"] = "Eliminar Gasto";
}

<h1>Eliminar gasto</h1>

<div class="alert alert-danger">
    <h4>¿Estás seguro de eliminar este gasto?</h4>
    <p>Esta acción no se puede deshacer.</p>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        Detalles del gasto
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Fecha</dt>
            <dd class="col-sm-9">@Model.FechaGasto.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Categoría</dt>
            <dd class="col-sm-9">
                <span class="badge rounded-pill" style="background-color:@Model.Categoria.Color; color:white;">
                    @Model.Categoria.Nombre
                </span>
            </dd>

            <dt class="col-sm-3">Monto (Bs.)</dt>
            <dd class="col-sm-9 fw-bold">Bs. @Model.Monto.ToString("N0")</dd>

            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Eliminar definitivamente
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>