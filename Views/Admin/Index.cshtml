@model Gestor_Gastos.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administración - Dashboard";
    Layout = "_Layout.Admin";
}

<div class="container-fluid">
    <h1 class="mb-4">
        <i class="bi bi-shield-lock"></i> Panel de Administración
    </h1>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Usuarios Totales</h6>
                    <h2 class="text-primary">@Model.TotalUsuarios</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-success h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Usuarios Activos</h6>
                    <h2 class="text-success">@Model.UsuariosActivos</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-info h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total de Gastos</h6>
                    <h2 class="text-info">@Model.TotalGastos</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-warning h-100">
                <div class="card-body text-center">
                    <h6 class="text-muted">Monto Total</h6>
                    <h2 class="text-warning">Bs. @Model.TotalMontoGastos.ToString("N0")</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Gastos por Categoría (Global)</h5>
                </div>
                <div class="card-body">
                    @if (Model.GastosPorCategoria.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Categoría</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.GastosPorCategoria)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge rounded-pill" style="background-color:@item.CategoriaColor; color:white;">
                                                    @item.CategoriaNombre
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold">Bs. @item.TotalMonto.ToString("N0")</td>
                                            <td class="text-end">@item.CantidadGastos</td>
                                            <td class="text-end">
                                                <span class="badge bg-secondary">@item.Porcentaje.ToString("F1")%</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle"></i> No hay datos de gastos registrados.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Gastos por Mes (Global)</h5>
                </div>
                <div class="card-body">
                    @if (Model.GastosPorMes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Mes</th>
                                        <th class="text-end">Monto Total</th>
                                        <th class="text-end">N° Gastos</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mes in Model.GastosPorMes)
                                    {
                                        <tr>
                                            <td>@mes.NombreMes</td>
                                            <td class="text-end">Bs. @mes.TotalMonto.ToString("N0")</td>
                                            <td class="text-end">@mes.CantidadGastos</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle"></i> No hay datos suficientes para mostrar.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Resumen por Usuario</h5>
                    <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-sm btn-outline-light">
                        Ver lista completa de usuarios
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.UsuariosResumen.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Username</th>
                                        <th>Nombre Completo</th>
                                        <th>Rol</th>
                                        <th>Estado</th>
                                        <th class="text-end">N° Gastos</th>
                                        <th class="text-end">Total Gastado</th>
                                        <th class="text-end">Promedio por Gasto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.UsuariosResumen)
                                    {
                                        <tr>
                                            <td>@u.Username</td>
                                            <td>@u.NombreCompleto</td>
                                            <td>@u.Rol</td>
                                            <td>
                                                @if (u.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-end">@u.CantidadGastos</td>
                                            <td class="text-end">Bs. @u.TotalMonto.ToString("N0")</td>
                                            <td class="text-end">Bs. @u.PromedioGasto.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle"></i> No hay usuarios con gastos registrados.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
